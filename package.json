{
  "name":"pes-gyj","version":"1.0.0","private":true,
  "description":"PES — Gimnasia y Esgrima de Jujuy: historia y estadísticas",
  "main":"electron/main.cjs",
  "scripts":{"build:web":"node scripts/build.mjs","build:windows":"npm run build:web && electron-builder --win nsis"},
  "dependencies":{"@capacitor/core":"7.4.3","@supabase/supabase-js":"2.57.4"},
  "devDependencies":{"@capacitor/android":"7.4.3","@capacitor/cli":"7.4.3","electron":"37.2.6","electron-builder":"26.0.12","esbuild":"0.25.5"},
  "build":{
    "appId":"com.gyj.pes.desktop","productName":"PES","directories":{"output":"release-win"},
    "files":["dist/**/*","electron/**/*","package.json"],
    "win":{"target":[{"target":"nsis","arch":["x64"]}],"artifactName":"PES-Windows-Setup.exe"},
    "nsis":{"oneClick":false,"perMachine":false,"allowToChangeInstallationDirectory":false,"deleteAppDataOnUninstall":false,"createDesktopShortcut":true,"createStartMenuShortcut":true,"runAfterFinish":true}
  }
}